{
    "package": "com.astra.whatsastra",
    "name": "WhatsAstra",
    "version": "3.3.0",
    "versionCode": 7,
    "description": "WhatsApp on astraOS: a native app, with WhatsApp's protocol on the phone itself.",
    "descriptions": {
        "it": "WhatsApp su astraOS: un'app nativa, con il protocollo di WhatsApp sul telefono stesso."
    },
    "main": "qml/Main.qml",
    "icon": "icon.svg",
    "category": "Social",
    "launcher": {
        "visible": true
    },
    "permissions": [
        "astra.permission.INTERNET",
        "astra.permission.NOTIFICATIONS",
        "astra.permission.MEDIA",
        "astra.permission.CONTACTS"
    ],
    "services": [
        {
            "id": "whatsapp",
            "exec": "bin/whatsastra-service"
        }
    ],
    "widgets": [],
    "accent": "#25D366"
}
