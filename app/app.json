{
    "package": "com.astra.whatsastra",
    "name": "WhatsAstra",
    "version": "1.0.1",
    "versionCode": 2,
    "description": "WhatsApp for astraOS, on top of WhatsApp Web: chats, voice notes, photos and notifications.",
    "descriptions": {
        "it": "WhatsApp per astraOS, basato su WhatsApp Web: chat, note vocali, foto e notifiche."
    },
    "main": "qml/Main.qml",
    "icon": "icon.svg",
    "background": "#0B141A",
    "category": "Social",
    "appearance": "dark",
    "webengine": true,
    "launcher": {
        "visible": true
    },
    "permissions": [
        "astra.permission.INTERNET",
        "astra.permission.NOTIFICATIONS",
        "astra.permission.MEDIA",
        "astra.permission.MICROPHONE",
        "astra.permission.CAMERA"
    ],
    "share": [
        "image/*",
        "video/*",
        "audio/*",
        "application/pdf",
        "text/plain"
    ],
    "widgets": []
}
